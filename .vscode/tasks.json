{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "预览无限流",
      "type": "process",
      "command": "python",
      "args": ["loading-page/serve.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "检查项目",
      "type": "process",
      "command": "python",
      "args": ["scripts/check-project.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
